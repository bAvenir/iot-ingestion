# Copy to .env and fill in. .env is gitignored; this file is committed.
# Values below are the compose defaults for local development.

LOG_LEVEL=INFO

# --- Postgres (pyiceberg SqlCatalog) ---
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://brewmaster:changeme@localhost:5432/lagerhaus
# From inside compose, swap the host: ...@postgres:5432/lagerhaus

# --- Valkey (task queue; also the only durable copy of inline payloads) ---
VALKEY_URL=redis://localhost:6379
# From inside compose: redis://valkey:6379

# --- RustFS server credentials (consumed by the container, not the app) ---
RUSTFS_ACCESS_KEY=admin
RUSTFS_SECRET_KEY=changeme

# --- S3 client (same credentials, consumed by the app) ---
S3_ACCESS_KEY=admin
S3_SECRET_KEY=changeme
S3_ENDPOINT=localhost
# From inside compose: rustfs
S3_PORT=9000
S3_USE_SSL=false
S3_PATH_STYLE=true
S3_REGION=us-east-1
S3_BUCKET_LANDING=landing
S3_BUCKET_WAREHOUSE=warehouse
S3_BUCKET_PUBLISHED=published

# --- Pipeline tuning (defaults live in config.py; override here) ---
# Inline payload threshold, 64 KB (open decision #3)
INLINE_PAYLOAD_MAX_BYTES=65536
# Bronze commit boundary: N messages or T seconds (open decision #2)
BRONZE_BATCH_SIZE=100
BRONZE_BATCH_WINDOW_SECONDS=10
